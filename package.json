{
  "name": "team-card-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22 <25"
  },
  "scripts": {
    "start": "npm run build && node scripts/run.mjs src/server/main.ts",
    "dev": "node scripts/run.mjs --watch src/server/main.ts --dev",
    "build": "node scripts/run.mjs scripts/validate-content.ts && node scripts/run.mjs node_modules/vite/bin/vite.js build",
    "check": "node scripts/run.mjs node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "lint": "node scripts/run.mjs node_modules/eslint/bin/eslint.js .",
    "test": "node scripts/run.mjs --test tests/rules/*.test.ts tests/server/*.test.ts",
    "test:e2e": "node scripts/run.mjs node_modules/@playwright/test/cli.js test",
    "smoke": "node scripts/run.mjs scripts/smoke.ts",
    "format": "node scripts/run.mjs node_modules/prettier/bin/prettier.cjs --write src content tests scripts docs *.json *.ts *.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/middie": "9.3.5",
    "@fastify/static": "10.1.6",
    "fastify": "5.12.7",
    "pinia": "4.1.0",
    "qrcode": "1.5.4",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
